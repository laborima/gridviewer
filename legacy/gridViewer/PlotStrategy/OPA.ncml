<?xml version='1.0' encoding='UTF-8'?>
<netcdf xmlns="http://www.unidata.ucar.edu/namespaces/netcdf/ncml-2.2" location="OPA" >

  <attribute name="Conventions" value="GDT 1.3"/>

  <variable name="nav_lat">
    <attribute name="_CoordinateAxisType" value="Lat" />
  </variable>

  <variable name="nav_lon">
    <attribute name="_CoordinateAxisType" value="Lon" />
  </variable>

  <variable name="deptht">
    <attribute name="_CoordinateAxisType" value="Height" />
    <attribute name="_CoordinateZisPositive" value="up" />
  </variable>

  <variable name="time_counter">
    <attribute name="_CoordinateAxisType" value="Time" />
  </variable>

</netcdf>